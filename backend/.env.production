# Production Environment Configuration for ProfileGPT
# This file contains production-ready settings

# Database - Production PostgreSQL (replace with your actual database URL)
DATABASE_URL=postgresql://username:password@host:port/profilegpt_prod
USE_SQLITE=false

# For Railway/Render auto-provisioned database
# DATABASE_URL=${DATABASE_URL}  # Will be auto-injected by hosting platform

# Premium AI Configuration - OpenAI Stack (Recommended)
LLM_PROVIDER=openai
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODEL=gpt-4o-mini
PREFERRED_AI_MODEL=gpt-4o-mini

# Alternative: Anthropic for complex reasoning
# ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# Premium embeddings for better accuracy
USE_LOCAL_EMBEDDINGS=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Fallback: Local embeddings (if no API key)
# USE_LOCAL_EMBEDDINGS=true
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# AI Budget Management
MONTHLY_AI_BUDGET=50.00
ENABLE_COST_TRACKING=true

# Application Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=52428800  # 50MB for better document support

# RAG Settings - Optimized for production
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVAL_CHUNKS=12
ENABLE_RERANKING=true

# CORS Settings - Update with your actual frontend domain
ALLOWED_ORIGINS=["https://your-app.vercel.app", "https://your-domain.com"]

# Performance Settings
WORKERS=2
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=120

# File Upload Settings
ALLOWED_FILE_TYPES=["pdf", "docx", "txt", "md", "html", "csv"]
MAX_FILE_SIZE=50MB

# Security
SECRET_KEY=${SECRET_KEY}
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: Redis for caching
# REDIS_URL=${REDIS_URL}

# Optional: Observability
# LANGFUSE_SECRET_KEY=${LANGFUSE_SECRET_KEY}
# LANGFUSE_PUBLIC_KEY=${LANGFUSE_PUBLIC_KEY}
# LANGFUSE_HOST=https://cloud.langfuse.com